rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ortak listeler: yalnız 12 haneli grup kodunu bilen okuyup yazabilir.
    // Gruplar listelenemez, liste silinemez, başka bir yere yazılamaz.
    match /gruplar/{kod}/listeler/{liste} {
      allow get: if kod.size() == 12;
      allow create, update: if kod.size() == 12
        && liste in ['bavul', 'ev', 'bavulOneri', 'evOneri']
        && request.resource.data.keys().hasOnly(['items'])
        && request.resource.data.items is map
        && request.resource.data.items.size() <= 300;
    }
  }
}
