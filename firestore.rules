rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ortak listeler: yalnız 12 haneli grup kodunu bilen okuyup yazabilir.
    // Gruplar listelenemez, liste silinemez, başka bir yere yazılamaz.
    match /gruplar/{kod}/listeler/{liste} {
      allow get: if kod.size() == 12;
      allow create, update: if kod.size() == 12
        && liste in ['bavul', 'ev', 'bavulOneri', 'evOneri', 'plan', 'masraf', 'telefon', 'park', 'gunluk']
        && request.resource.data.keys().hasOnly(['items'])
        && request.resource.data.items is map
        && request.resource.data.items.size() <= 300;
    }
    // Fotoğraflar: önizleme ayrı, büyük resim ayrı belgede (1 MB sınırı yüzünden)
    match /gruplar/{kod}/foto/{id} {
      allow get, list: if kod.size() == 12;
      allow create: if kod.size() == 12
        && request.resource.data.keys().hasOnly(['d', 's', 'th'])
        && request.resource.data.d is string && request.resource.data.d.size() <= 12
        && request.resource.data.th is string && request.resource.data.th.size() < 100000;
      allow delete: if kod.size() == 12;
    }
    match /gruplar/{kod}/fotoBuyuk/{id} {
      allow get: if kod.size() == 12;
      allow create: if kod.size() == 12
        && request.resource.data.keys().hasOnly(['b'])
        && request.resource.data.b is string && request.resource.data.b.size() < 1000000;
      allow delete: if kod.size() == 12;
    }
  }
}
